{"actor":"lucidota","created_at":"2026-10-08T18:05:34Z","hash":"08f20a0a13d2b8fbdf19b01f5384c0b61280b860fca3dea989178937f0bb039a","id":"I1","kind":"principle","prev_hash":"GENESIS","rationale":"RFC-002 section 6","schema":1,"severity":"non_negotiable","status":"active","text":"AI agents cannot self-certify. An AI assertion cannot create PL VERIFIED."}
